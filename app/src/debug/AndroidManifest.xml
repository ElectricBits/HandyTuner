<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb open the Quick Menu / HUD for screenshots.
     android.permission.DUMP is held by the adb shell and not by apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugReceiver"
            android:process=":overlay"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
